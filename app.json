{
  "expo": {
    "name": "MUWOYOTRANSLATE",
    "slug": "MUWOYOTRANSLATE",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "scheme": "muwoyotranslate",
    "icon": "./assets/muwoyo-brand.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.MUWOYOTRANSLATE"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080B10",
        "foregroundImage": "./assets/muwoyo-brand.png",
        "monochromeImage": "./assets/muwoyo-brand.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.anonymous.MUWOYOTRANSLATE"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-audio",
      "expo-speech-recognition",
      "expo-sharing",
      "@livekit/react-native-expo-plugin"
    ]
  }
}
